program Ur7;
// Практическая работа 1
// Задача 10. Составить программу решения линейного уравнения ax+b=0 (a ≠ 0).
{$APPTYPE CONSOLE}

{$R *.res}
{
Постановка задачи: составить программу решения линейного уравнения ax+b=0 (a ≠ 0)
Словестный алгоритм
1. определение данных a = от 1 до 100, b = от -100 до 100
Выбираем нужные типы a - byte, b - shortint
2. Объявляем переменные и назначаем им соответсвующий тип данных
a - byte
b - shortint
x - real
3. инициализируем переменные - то есть присваиваем им значения
переменные a и b ввести с клавиатуры
4. формулируем выражение x = -b/a
5. выводим результат на экран
6. ставим точку останова для контроля
7. компилируем код

}
uses
  System.SysUtils;
  var
  a: byte;
  b: shortint;
  x: real;

begin

   // 3. инициализируем переменные
   Write('Введите переменную a = ');
   ReadLn(a);
   Write('Введите переменную b = ');
   ReadLn(b);
   // 4. формулируем выражение x = -b/a
   x := -b/a;
   // 5. выводим результат на экран   форматирование вещественного числа :2:2
   // где :2 - количество целых чисел       :2 - количество вещественных знаков
   WriteLn('Выражение x = -b/a = ',x:2:2);

   WriteLn('Конец программы');
   ReadLn;

end.
