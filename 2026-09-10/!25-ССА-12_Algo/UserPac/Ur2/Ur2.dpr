    { TODO -oUser -cConsole Main : Insert code here }
  except
    on E: Exception do
      Writeln(E.ClassName, ': ', E.Message);
  end;
  *)

  //Точка входа в программу
  //2. Инициализировать переменну текстом
  st := 'Это первая программа на Pascal' ;

  //3. Вывести переменную на экран
  WriteLn(st);

   //4. остановить выполнение программы, просмотреть результат
    ReadLn; //точка остановки


end.     // операторные скобки (конец программы)
