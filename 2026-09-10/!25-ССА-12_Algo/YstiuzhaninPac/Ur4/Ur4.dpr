program Ur4;
// урок 4. јлфавит и словарь €зыка Pascal
//јлфавит ѕаскал€ составл€ют:
//прописные и строчные буквы латинского алфавита: регистронезависимый
//A, B, CЕY, Z, a, b, cЕy, z;

//дес€тичные цифры: 0, 1, 2Е9;
//специальные символы:
//+ - *  / > < = ; # С , . : {} []  (  )  ;

//комбинации специальных символов, которые нельз€ раздел€ть пробелами, если они используютс€ как знаки операций:
